# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/saccofraudguard?schema=public"

# Authentication
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Email (optional in local dev)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@saccofraudguard.co.ke"

# Daraja STK Push (optional - required to trigger M-Pesa prompts)
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE="174379"
DARAJA_PASSKEY=""
DARAJA_CALLBACK_URL="https://your-domain.com/api/payments/daraja/callback"
DARAJA_TRANSACTION_TYPE="CustomerPayBillOnline"
DARAJA_BASE_URL="https://sandbox.safaricom.co.ke"
